# ============================================================
# MAHADEV KING - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git/version control!
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=your_db_name

# --- AquaSMS ---
AQUASMS_USERNAME=your_sms_username
AQUASMS_APIKEY=your-aquasms-api-key-here
AQUASMS_SENDERNAME=CRTFUL
AQUASMS_SMSTYPE=TRANS
AQUASMS_BASE_URL=http://login.aquasms.com
AQUASMS_PEID=your_peid_here
AQUASMS_TEMPLATEID=your_templateid_here

# --- FCM / Firebase ---
FCM_PROJECT_ID=your-firebase-project-id
GOOGLE_SA_JSON_PATH=secure/service-account.json

# --- IMB Payment Gateway ---
IMB_TOKEN_FALLBACK=your_imb_token_here

# --- YuviPay Payment Gateway ---
YUVIPAY_SECRET_KEY=your_yuvipay_secret_key_here
YUVIPAY_MERCH_ID=your_yuvipay_merchant_id_here

