# PostgreSQL Database Connection URL (e.g. from Render PostgreSQL, Supabase, Neon, or Railway)
DATABASE_URL=postgresql://subh_user:password@dpg-xxxx-a.oregon-postgres.render.com/subh_gaming_db?sslmode=require

# Node Environment
NODE_ENV=production

# Application Port (Render automatically supplies $PORT, default is 3000 for local)
PORT=3000

